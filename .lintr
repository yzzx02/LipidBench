# .lintr 配置文件 - 忽略R代码检查的特定规则
linters: linters_with_defaults(
  # 忽略行长度超过80字符的提示
  line_length_linter = NULL,
  # 忽略行尾空格的提示
  trailing_whitespace_linter = NULL,
  # 忽略变量命名规范的提示（如是否用蛇形命名）
  object_name_linter = NULL,
  # 忽略括号内空格的提示
  spaces_inside_linter = NULL,
  # 忽略逗号后未加空格的提示
  commas_linter = NULL,
  # 忽略多余空行的提示
  blank_lines_linter = NULL
)
