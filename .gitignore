# Raw input and generated scientific/reproduction artifacts are local only
/data/
*.mzML
*.mzXML
*.raw
*.cdf
*.csv
*.tsv
*.xlsx
*.xls
*.txt
*.json
*.jsonl
*.sha256
*.log
*.npy
*.npz
*.zip
*.tar
*.tar.gz
*.7z

# Paper figures must never be committed, including TIFF and SVG
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.webp
*.tif
*.tiff
*.pdf
*.svg

# Checkpoints and runtime model data; the Python model package remains source
*.pth
*.pt
*.ckpt
*.pkl
*.pickle
runs/
tb_logs/
models/
!/lipidbench/models/

# Maintained source configuration and locked canonical dataset metadata
!/requirements*.txt
!/PeakTruthLab/configs/*.json
!/PeakTruthLab/configs/labelme_labels.txt
