# 忽略所有数据文件
*.mzML
*.raw
*.cdf
*.csv
*.txt
*.pdf



# 忽略Python产生的缓存垃圾
__pycache__/
*.pyc
.pytest_cache/


#忽略虚拟环境
.venv/

# 忽略所有 .npy 文件
*.npy

# 忽略所有.jpeg和.json文件
*.jpeg
*.json
*.png
*.jsonl
*.sha256


# =========================
# IDE & 操作系统自动生成文件
# =========================
.vscode/
.idea/
.DS_Store
Thumbs.db

# =========================
# 深度学习模型 (PyTorch等)
# =========================
# 模型权重文件非常大，强烈建议忽略，避免撑爆 Git 仓库
*.pth
*.pt
*.ckpt
runs/
tb_logs/
models/

# Keep the PeakTruthLab model package and canonical dataset metadata in Git.
!/lipidbench/models/
!/PeakTruthLab/configs/*.json
!/PeakTruthLab/datasets/feature_table_final_15409.csv
!/PeakTruthLab/datasets/feature_table_final_15409.audit.json
!/requirements-dev.txt
!/requirements-peak-common.txt
!/requirements-peak-nvidia-cu128.txt

# Review workbooks are local deliverables, not runtime inputs.
*.xlsx

# Local accelerator environments, diagnostics, results, and release builds.
.venv*/
.codex_tmp/
PeakTruthLab/results/
PeakTruthLab/releases/

# Compact final delivery and inspectable final dataset metadata stay in Git.
!/PeakTruthLab/final_delivery/
!/PeakTruthLab/final_delivery/**
!/PeakTruthLab/datasets/PeakTruthLab_final_merged_20260814/tables/
!/PeakTruthLab/datasets/PeakTruthLab_final_merged_20260814/tables/*.csv
!/PeakTruthLab/datasets/PeakTruthLab_final_merged_20260814/audits/
!/PeakTruthLab/datasets/PeakTruthLab_final_merged_20260814/audits/*.csv
!/PeakTruthLab/datasets/PeakTruthLab_final_merged_20260814/audits/*.json
!/PeakTruthLab/datasets/PeakTruthLab_final_merged_20260814/splits/
!/PeakTruthLab/datasets/PeakTruthLab_final_merged_20260814/splits/*.csv
!/PeakTruthLab/datasets/PeakTruthLab_final_merged_20260814/splits/*.json
!/PeakTruthLab/datasets/PeakTruthLab_final_merged_20260814/splits/*.sha256
